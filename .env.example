# TerraShift Environment Configuration
# Adheres strictly to Zero-Secrets Rule (all secrets loaded at runtime, no hardcoded fallbacks)

PROJECT_NAME=TerraShift
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# NASA POWER API Endpoint (Publicly accessible Earth Observation REST API)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Cache & Storage
CACHE_DIR=backend/data_cache
CACHE_TTL_HOURS=24
