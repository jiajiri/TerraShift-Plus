# --- NASA EARTHDATA / AppEEARS CREDENTIALS (https://urs.earthdata.nasa.gov) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- iSDAsoil AFRICA 30m SOIL API (https://api.isda-africa.com) ---
ISDA_USERNAME=
ISDA_PASSWORD=

# --- HARVEST PORTAL (Optional; public GET requires no token) ---
HARVEST_API_TOKEN=

# --- GOOGLE GEMINI AI LLM CONFIGURATION ---
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- VERIFIED UPSTREAM BASE URLS ---
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_APPEEARS_URL=https://appeears.earthdatacloud.nasa.gov/api
NASA_GLAM_URL=https://glam1.gsfc.nasa.gov/api/gettbl/v4
NASA_CMR_URL=https://cmr.earthdata.nasa.gov/search/granules.json
ISDA_SOIL_URL=https://api.isda-africa.com
HARVEST_PORTAL_URL=https://data.harvestportal.org/api/3/action
SOILGRIDS_FALLBACK_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# --- PATHS ---
DATA_CACHE_DIR=data_cache
MODEL_ARTIFACT_DIR=app/models
